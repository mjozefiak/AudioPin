      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie teraz"
          }
        }
      }
    },
    "Notifications are turned off. Allow them in System Settings → Notifications.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są zablokowane. Zezwól na nie w Ustawieniach systemowych → Powiadomienia."
          }
        }
      }
    },
    "Notify on every correction": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie przy każdej korekcie"
          }
        }
      }
    },
