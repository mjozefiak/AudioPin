    },
    "Drag to reorder": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność"
          }
        }
      }
    },
    "Drag to reorder. The first connected, enabled device is used. Disabled devices are never selected automatically.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Używane jest pierwsze podłączone i włączone urządzenie. Wyłączone urządzenia nigdy nie są wybierane automatycznie."
          }
        }
      }
    },
    "Exclude from Automatic Selection": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz z automatycznego wyboru"
          }
        }
      }
    },
    "Excluded from automatic selection": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone z automatycznego wyboru"
          }
        }
      }
    },
