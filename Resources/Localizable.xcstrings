      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejność wyjść dźwięku"
          }
        }
      }
    },
    "Pause AudioPin": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj pilnowanie urządzeń"
          }
        }
      }
    },
