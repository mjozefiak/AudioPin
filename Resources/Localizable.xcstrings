    "New Bluetooth microphones (such as AirPods) and iPhone microphones start disabled.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe mikrofony Bluetooth (np. AirPods) i iPhone'a są domyślnie wyłączone."
