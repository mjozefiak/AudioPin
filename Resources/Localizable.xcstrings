      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne"
          }
        }
      }
    },
    "Otherwise your devices are only pinned after you open the app yourself.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tego Twoje urządzenia będą pilnowane dopiero po ręcznym otwarciu aplikacji."
          }
        }
      }
    },
    "Output": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjście"
          }
        }
      }
    },
