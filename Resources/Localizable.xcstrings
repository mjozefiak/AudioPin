      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięki systemowe idą za wybranym wyjściem"
          }
        }
      }
    },
    "All quiet — AudioPin hasn’t had to correct anything yet.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie spokojnie — AudioPin nie musiał niczego poprawiać."
          }
        }
      }
    },
