      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głośniki i słuchawki"
          }
        }
      }
    },
    "Startup": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamianie"
          }
        }
      }
    },
    "The system keeps switching devices — pausing corrections for 30 s": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System ciągle przełącza urządzenie — wstrzymuję korekty na 30 s"
          }
        }
      }
    },
    "Tip: in Zoom, Teams or Discord choose “Same as System” for the microphone and speaker, so these apps follow AudioPin too.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: w Zoom, Teams czy Discord wybierz mikrofon „Taki jak systemowy”, żeby te aplikacje też korzystały z urządzeń wybranych przez AudioPin."
          }
        }
      }
    },
    "Turn On": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz"
          }
        }
      }
    },
    "Turn off to never select automatically": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz — nigdy nie wybieraj automatycznie"
          }
        }
      }
    },
    "Unknown Device": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieznane urządzenie"
          }
        }
      }
    },
    "Virtual": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirtualne"
          }
        }
      }
    },
    "When macOS switches a device (for example after you connect AirPods), AudioPin immediately restores the first connected, enabled device from your list.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy macOS przełączy urządzenie (np. po podłączeniu AirPods), AudioPin od razu przywróci pierwsze dostępne i włączone urządzenie z Twojej listy."
          }
        }
      }
    },
    "another device": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "inne urządzenie"
          }
        }
      }
    },
