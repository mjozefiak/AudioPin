      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS wymaga zatwierdzenia w Ustawieniach systemowych."
          }
        }
      }
    },
    "not pinned": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "bez pilnowania"
          }
        }
      }
